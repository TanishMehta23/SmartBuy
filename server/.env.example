PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_catalog?schema=public"

# Admin Authentication
JWT_SECRET=super_secret_jwt_key_store_catalog_production_change_me
JWT_EXPIRES_IN=7d

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@storecatalog.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS and Cookie security)
CLIENT_URL=http://localhost:5173
